# Scratch Area
docs/scratch/
.project-pipeline/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.mypy_cache/
.pyright/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*

# Node (Prettier toolchain)
node_modules/

# Repository-local executable Go tools installed by `make go-tools`.
.tools/

# Transient Prettier probe dirs created inside the repo tree by the parity oracle
# (mkdtemp needs an in-tree path so the `**/*.md` singleQuote override applies —
# an out-of-tree probe silently uses the wrong config). They now live under the
# already-ignored `build/prettier-probes/` rather than in the repository root, so
# their churn is invisible to the suites that digest or copy the root whole; this
# pattern only catches leftovers from a pre-5.13 checkout.
prettier_probe_*/

# Editor/backup snapshots (never tracked)
*.bak

# Superpowers subagent-driven-development scratch (machine-generated task briefs/
# reports). A nested .superpowers/sdd/.gitignore already hides these from git, but
# Prettier only reads the root ignore files — declaring the dir here keeps the
# repo-wide `prettier --check .` gate green on these local-only transcripts.
.superpowers/

# Analysis working space (code-simplification runs)
.scratch/
.workflow/
