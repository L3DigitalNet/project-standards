{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["organization", "harnesses"],
	"properties": {
		"organization": { "type": "string", "minLength": 1 },
		"harnesses": {
			"type": "array",
			"items": { "enum": ["claude-code", "codex"] },
			"minItems": 1,
			"uniqueItems": true
		}
	}
}
