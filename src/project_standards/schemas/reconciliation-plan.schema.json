{
  "$defs": {
    "AcceptedTrack": {
      "additionalProperties": false,
      "description": "Durable authorization evidence for one non-default package major.",
      "properties": {
        "authorized_catalog": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Authorized Catalog",
          "type": "string"
        },
        "major": {
          "minimum": 1,
          "title": "Major",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "authorized_catalog"
      ],
      "title": "AcceptedTrack",
      "type": "object"
    },
    "ActionKind": {
      "description": "Repository mutation or preservation decisions emitted by planning.",
      "enum": [
        "create",
        "adopt",
        "update",
        "remove",
        "preserve",
        "no-op"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AdapterKind": {
      "description": "Semantic container adapters supported by the V1 contribution contract.",
      "enum": [
        "whole-file",
        "toml",
        "json",
        "jsonc",
        "yaml",
        "editorconfig",
        "markdown-block"
      ],
      "title": "AdapterKind",
      "type": "string"
    },
    "AppliedPackage": {
      "additionalProperties": false,
      "description": "Resolved facts for one enabled package; authorization lives elsewhere.",
      "properties": {
        "effective_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Config Digest",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "requested": {
          "$ref": "#/$defs/VersionSelector"
        },
        "resolved": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Resolved",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/SelectionKind"
        }
      },
      "required": [
        "requested",
        "resolved",
        "selection",
        "payload_digest",
        "effective_config_digest"
      ],
      "title": "AppliedPackage",
      "type": "object"
    },
    "ArtifactPolicy": {
      "description": "Lifecycle policies supported by managed package outputs.",
      "enum": [
        "managed",
        "create-only"
      ],
      "title": "ArtifactPolicy",
      "type": "string"
    },
    "CentralLock": {
      "additionalProperties": false,
      "description": "Complete tool-owned applied, authorization, ownership, and input state.",
      "properties": {
        "accepted_tracks": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "$ref": "#/$defs/AcceptedTrack"
            }
          },
          "title": "Accepted Tracks",
          "type": "object"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/LockedUnit"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "create_only_absences": {
          "items": {
            "$ref": "#/$defs/CreateOnlyAbsence"
          },
          "title": "Create Only Absences",
          "type": "array"
        },
        "project_standards": {
          "$ref": "#/$defs/LockHeader"
        },
        "referenced_inputs": {
          "items": {
            "$ref": "#/$defs/LockedInput"
          },
          "title": "Referenced Inputs",
          "type": "array"
        },
        "standards": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "$ref": "#/$defs/AppliedPackage"
            }
          },
          "title": "Standards",
          "type": "object"
        }
      },
      "required": [
        "project_standards"
      ],
      "title": "CentralLock",
      "type": "object"
    },
    "CreateOnlyAbsence": {
      "additionalProperties": false,
      "description": "Ownership facts retained for an absent create-only semantic unit.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "owners": {
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Owners",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/UnitProvenance"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "shared_identity": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[./_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared Identity"
        },
        "versions": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "path",
        "adapter",
        "scope",
        "owners",
        "versions",
        "provenance"
      ],
      "title": "CreateOnlyAbsence",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "LockHeader": {
      "additionalProperties": false,
      "description": "Digests binding applied state to one tool release, catalog, and config.",
      "properties": {
        "catalog": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Catalog",
          "type": "string"
        },
        "catalog_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Catalog Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "release": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Release",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "catalog",
        "release",
        "catalog_digest",
        "config_digest"
      ],
      "title": "LockHeader",
      "type": "object"
    },
    "LockedInput": {
      "additionalProperties": false,
      "description": "Consumer-owned referenced input tracked without managed ownership.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "extension_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Extension Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "extension_id",
        "path",
        "digest"
      ],
      "title": "LockedInput",
      "type": "object"
    },
    "LockedUnit": {
      "additionalProperties": false,
      "description": "Central ownership and drift record for one normalized semantic unit.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "created_container": {
          "title": "Created Container",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "pattern": "^0[0-7]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "owners": {
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Owners",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ArtifactPolicy"
        },
        "provenance": {
          "$ref": "#/$defs/UnitProvenance"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "semantic_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Semantic Digest",
          "type": "string"
        },
        "shared_identity": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[./_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared Identity"
        },
        "versions": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "path",
        "adapter",
        "scope",
        "owners",
        "versions",
        "provenance",
        "policy",
        "semantic_digest",
        "content_digest",
        "created_container"
      ],
      "title": "LockedUnit",
      "type": "object"
    },
    "PublicActionSchema": {
      "additionalProperties": false,
      "description": "Content-safe action fields included in public reconciliation output.",
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "after_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Digest"
        },
        "after_mode": {
          "anyOf": [
            {
              "pattern": "^0[0-7]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Mode"
        },
        "before_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Digest"
        },
        "before_mode": {
          "anyOf": [
            {
              "pattern": "^0[0-7]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Mode"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "standard_id": {
          "title": "Standard Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "adapter",
        "scope",
        "standard_id",
        "summary"
      ],
      "title": "PublicActionSchema",
      "type": "object"
    },
    "PublicCatalogLineageSchema": {
      "additionalProperties": false,
      "description": "One catalog identity in a planned installed-catalog refresh.",
      "properties": {
        "catalog": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Catalog",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "release": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Release",
          "type": "string"
        }
      },
      "required": [
        "catalog",
        "release",
        "digest"
      ],
      "title": "PublicCatalogLineageSchema",
      "type": "object"
    },
    "PublicCatalogRefreshSchema": {
      "additionalProperties": false,
      "description": "Public lineage and selection facts for an installed-catalog refresh.",
      "properties": {
        "affected_selections": {
          "items": {
            "$ref": "#/$defs/PublicCatalogSelectionChangeSchema"
          },
          "title": "Affected Selections",
          "type": "array"
        },
        "after": {
          "$ref": "#/$defs/PublicCatalogLineageSchema"
        },
        "before": {
          "$ref": "#/$defs/PublicCatalogLineageSchema"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/ReleaseClassification"
        }
      },
      "required": [
        "changed",
        "classification",
        "before",
        "after"
      ],
      "title": "PublicCatalogRefreshSchema",
      "type": "object"
    },
    "PublicCatalogSelectionChangeSchema": {
      "additionalProperties": false,
      "description": "One enabled package selection changed by catalog refresh.",
      "properties": {
        "current": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Current",
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous"
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "previous",
        "current"
      ],
      "title": "PublicCatalogSelectionChangeSchema",
      "type": "object"
    },
    "PublicFindingSchema": {
      "additionalProperties": false,
      "description": "Content-safe finding fields included in public reconciliation output.",
      "properties": {
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Digest"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Digest"
        },
        "first_difference_expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Difference Expected"
        },
        "first_difference_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Difference Line"
        },
        "governing_options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governing Options"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "locus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locus"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "standard_id": {
          "title": "Standard Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "standard_id",
        "version",
        "path",
        "identity",
        "message",
        "hint"
      ],
      "title": "PublicFindingSchema",
      "type": "object"
    },
    "PublicPlannedUnitSchema": {
      "additionalProperties": false,
      "description": "One public semantic-unit transition with package provenance.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "after_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Digest"
        },
        "before_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Digest"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "owners": {
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/UnitProvenance"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "shared_identity": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[./_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shared Identity"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "versions": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "target",
        "adapter",
        "scope",
        "owners",
        "shared_identity",
        "versions",
        "provenance",
        "before_digest",
        "after_digest"
      ],
      "title": "PublicPlannedUnitSchema",
      "type": "object"
    },
    "PublicProviderNoticeSchema": {
      "additionalProperties": false,
      "description": "One content-safe notice emitted by a package provider.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "version",
        "provider_id",
        "message"
      ],
      "title": "PublicProviderNoticeSchema",
      "type": "object"
    },
    "PublicResolutionSchema": {
      "additionalProperties": false,
      "description": "Public package selections and accepted-major transitions.",
      "properties": {
        "packages": {
          "items": {
            "$ref": "#/$defs/PublicResolvedPackageSchema"
          },
          "title": "Packages",
          "type": "array"
        },
        "track_transitions": {
          "items": {
            "$ref": "#/$defs/PublicTrackTransitionSchema"
          },
          "title": "Track Transitions",
          "type": "array"
        }
      },
      "title": "PublicResolutionSchema",
      "type": "object"
    },
    "PublicResolvedPackageSchema": {
      "additionalProperties": false,
      "description": "One package selection and its public applied-state facts.",
      "properties": {
        "applied": {
          "$ref": "#/$defs/AppliedPackage"
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "applied"
      ],
      "title": "PublicResolvedPackageSchema",
      "type": "object"
    },
    "PublicTargetPreconditionSchema": {
      "additionalProperties": false,
      "description": "One target identity bound to the snapshot observed during planning.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "digest"
      ],
      "title": "PublicTargetPreconditionSchema",
      "type": "object"
    },
    "PublicTrackTransitionSchema": {
      "additionalProperties": false,
      "description": "One accepted-major authorization transition.",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptedTrack"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/TrackTransitionKind"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptedTrack"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "kind",
        "previous",
        "current"
      ],
      "title": "PublicTrackTransitionSchema",
      "type": "object"
    },
    "PublicVerificationRequestSchema": {
      "additionalProperties": false,
      "description": "One package verification provider deferred until apply.",
      "properties": {
        "provider_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "standard_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Standard Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "standard_id",
        "version",
        "provider_id"
      ],
      "title": "PublicVerificationRequestSchema",
      "type": "object"
    },
    "ReleaseClassification": {
      "description": "Minimum tool release level, or a change that cannot be released.",
      "enum": [
        "patch",
        "minor",
        "major",
        "forbidden"
      ],
      "title": "ReleaseClassification",
      "type": "string"
    },
    "SelectionKind": {
      "description": "Resolution channel recorded for an applied package.",
      "enum": [
        "stable",
        "retained",
        "breaking-candidate",
        "exact"
      ],
      "title": "SelectionKind",
      "type": "string"
    },
    "TrackTransitionKind": {
      "description": "Mutation required in the lock's independent authorization partition.",
      "enum": [
        "create",
        "replace",
        "remove"
      ],
      "title": "TrackTransitionKind",
      "type": "string"
    },
    "UnitProvenance": {
      "description": "Origin of an applied semantic unit's materialized value.",
      "enum": [
        "source",
        "provider",
        "generated",
        "package",
        "external"
      ],
      "title": "UnitProvenance",
      "type": "string"
    },
    "VersionSelector": {
      "anyOf": [
        {
          "const": "latest",
          "type": "string"
        },
        {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/L3DigitalNet/project-standards/main/src/project_standards/schemas/reconciliation-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stable JSON surface for a complete reconciliation preview.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/PublicActionSchema"
      },
      "title": "Actions",
      "type": "array"
    },
    "applicable": {
      "title": "Applicable",
      "type": "boolean"
    },
    "catalog_refresh": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicCatalogRefreshSchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/PublicFindingSchema"
      },
      "title": "Findings",
      "type": "array"
    },
    "namespace_prunes": {
      "items": {
        "type": "string"
      },
      "title": "Namespace Prunes",
      "type": "array"
    },
    "next_lock": {
      "anyOf": [
        {
          "$ref": "#/$defs/CentralLock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/PublicTargetPreconditionSchema"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "proposed_lock": {
      "$ref": "#/$defs/CentralLock"
    },
    "provider_notices": {
      "items": {
        "$ref": "#/$defs/PublicProviderNoticeSchema"
      },
      "title": "Provider Notices",
      "type": "array"
    },
    "resolution": {
      "$ref": "#/$defs/PublicResolutionSchema"
    },
    "schema_version": {
      "const": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/PublicPlannedUnitSchema"
      },
      "title": "Units",
      "type": "array"
    },
    "verification_requests": {
      "items": {
        "$ref": "#/$defs/PublicVerificationRequestSchema"
      },
      "title": "Verification Requests",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "applicable",
    "proposed_lock"
  ],
  "title": "ReconciliationPlanSchema",
  "type": "object"
}
