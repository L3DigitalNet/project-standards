{
  "$defs": {
    "ActionKind": {
      "description": "Repository mutation or preservation decisions emitted by planning.",
      "enum": [
        "create",
        "adopt",
        "update",
        "remove",
        "preserve",
        "no-op"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AdapterKind": {
      "description": "Semantic container adapters supported by the V1 contribution contract.",
      "enum": [
        "whole-file",
        "toml",
        "json",
        "jsonc",
        "yaml",
        "editorconfig",
        "markdown-block"
      ],
      "title": "AdapterKind",
      "type": "string"
    },
    "MutationActionSchema": {
      "additionalProperties": false,
      "description": "One bounded repository mutation returned to the platform executor.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "content_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Base64"
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "mode": {
          "anyOf": [
            {
              "pattern": "^0[0-7][0145][0145]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "precondition_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Precondition Digest",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "adapter",
        "scope",
        "summary",
        "precondition_digest"
      ],
      "title": "MutationActionSchema",
      "type": "object"
    },
    "MutationDiagnosticSchema": {
      "additionalProperties": false,
      "description": "Content-safe package diagnostic accompanying an authoring plan.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "refusal": {
          "default": false,
          "title": "Refusal",
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "MutationDiagnosticSchema",
      "type": "object"
    },
    "ProjectSpecImportBlockSchema": {
      "additionalProperties": false,
      "description": "One source byte range and its exact target-byte preservation location.",
      "properties": {
        "destination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "diagnostic_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic Code"
        },
        "disposition": {
          "enum": [
            "mapped",
            "review"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "fence": {
          "pattern": "^`{3,}$",
          "title": "Fence",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "target_end": {
          "exclusiveMinimum": 0,
          "title": "Target End",
          "type": "integer"
        },
        "target_start": {
          "minimum": 0,
          "title": "Target Start",
          "type": "integer"
        }
      },
      "required": [
        "ordinal",
        "start",
        "end",
        "source_digest",
        "disposition",
        "target_start",
        "target_end",
        "fence"
      ],
      "title": "ProjectSpecImportBlockSchema",
      "type": "object"
    },
    "ProjectSpecImportDiagnosticSchema": {
      "additionalProperties": false,
      "description": "Content-safe owner-decision diagnostic for one reviewed source block.",
      "properties": {
        "classification": {
          "enum": [
            "preamble",
            "unmapped",
            "duplicate"
          ],
          "title": "Classification",
          "type": "string"
        },
        "code": {
          "enum": [
            "SPEC-IMPORT-PREAMBLE",
            "SPEC-IMPORT-UNMAPPED",
            "SPEC-IMPORT-DUPLICATE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "ordinal",
        "classification",
        "message"
      ],
      "title": "ProjectSpecImportDiagnosticSchema",
      "type": "object"
    },
    "ProjectSpecImportReportSchema": {
      "additionalProperties": false,
      "description": "Closed deterministic preservation report for one legacy-spec import.",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/ProjectSpecImportBlockSchema"
          },
          "title": "Blocks",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/ProjectSpecImportDiagnosticSchema"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "project-spec-import-plan-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_size": {
          "minimum": 0,
          "title": "Source Size",
          "type": "integer"
        },
        "source_snapshot": {
          "$ref": "#/$defs/ProjectSpecImportSnapshotSchema"
        },
        "spec_id": {
          "pattern": "^SPEC-[0-9A-Z]{4}$",
          "title": "Spec Id",
          "type": "string"
        },
        "target_content_base64": {
          "title": "Target Content Base64",
          "type": "string"
        },
        "target_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Content Digest",
          "type": "string"
        },
        "target_snapshot": {
          "$ref": "#/$defs/ProjectSpecImportSnapshotSchema"
        }
      },
      "required": [
        "schema_version",
        "source_snapshot",
        "target_snapshot",
        "spec_id",
        "source_size",
        "target_content_digest",
        "target_content_base64",
        "plan_digest"
      ],
      "title": "ProjectSpecImportReportSchema",
      "type": "object"
    },
    "ProjectSpecImportSnapshotSchema": {
      "additionalProperties": false,
      "description": "One immutable source or target identity retained by an import plan.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "ProjectSpecImportSnapshotSchema",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/L3DigitalNet/project-standards/main/src/project_standards/schemas/mutation-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed mutation intent and diagnostics returned by a package provider.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/MutationActionSchema"
      },
      "title": "Actions",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/MutationDiagnosticSchema"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "import_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectSpecImportReportSchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "standard_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Standard Id",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "standard_id",
    "version"
  ],
  "title": "MutationPlanSchema",
  "type": "object"
}
